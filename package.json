{
  "name": "morrowmere",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode android",
    "preview": "vite preview",
    "test": "vitest --pool=threads",
    "test:run": "vitest run --pool=threads",
    "content:validate": "vitest run --pool=threads tests/content/chronicle1-effects.test.ts tests/content/chronicle1-validation.test.ts tests/content/chronicle1-routes.test.ts",
    "content:export": "node scripts/content/export-chronicle1-manifest.mjs",
    "test:e2e": "playwright test",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "8.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.11"
  }
}
